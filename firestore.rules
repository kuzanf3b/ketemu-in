rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'fauzn88br@gmail.com' ||
        request.auth.token.email == 'admin@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    // 1. User Entity Validation
    function isValidUser(data) {
      return data.keys().hasAll(['nama_lengkap', 'no_whatsapp', 'rt_rw'])
          && data.keys().size() <= 10
          && data.nama_lengkap is string && data.nama_lengkap.size() >= 1 && data.nama_lengkap.size() <= 100
          && data.no_whatsapp is string && data.no_whatsapp.size() >= 8 && data.no_whatsapp.size() <= 20
          && data.rt_rw is string && data.rt_rw.size() >= 1 && data.rt_rw.size() <= 30
          && (!('id_user' in data) || (data.id_user is string && data.id_user.size() <= 128))
          && (!('email' in data) || (data.email is string && data.email.size() <= 120))
          && (!('foto_profil' in data) || data.foto_profil is string)
          && (!('created_at' in data) || data.created_at is string)
          && (!('is_admin' in data) || data.is_admin is bool);
    }

    // 2. Report Entity Validation
    function isValidReport(data) {
      return data.keys().hasAll(['id_user', 'tipe_laporan', 'kategori', 'judul', 'deskripsi', 'lokasi', 'tgl_kejadian', 'status_selesai'])
          && data.keys().size() <= 16
          && data.id_user is string && data.id_user.size() <= 128
          && data.tipe_laporan in ['HILANG', 'DITEMUKAN']
          && data.kategori is string && data.kategori.size() >= 1 && data.kategori.size() <= 50
          && data.judul is string && data.judul.size() >= 3 && data.judul.size() <= 150
          && data.deskripsi is string && data.deskripsi.size() >= 3 && data.deskripsi.size() <= 2000
          && data.lokasi is string && data.lokasi.size() >= 2 && data.lokasi.size() <= 200
          && data.tgl_kejadian is string && data.tgl_kejadian.size() <= 30
          && data.status_selesai is bool
          && (!('id_report' in data) || (data.id_report is string && data.id_report.size() <= 128))
          && (!('foto_url' in data) || data.foto_url is string)
          && (!('created_at' in data) || data.created_at is string)
          && (!('user_nama' in data) || (data.user_nama is string && data.user_nama.size() <= 100))
          && (!('user_whatsapp' in data) || (data.user_whatsapp is string && data.user_whatsapp.size() <= 30))
          && (!('status_disetujui' in data) || data.status_disetujui is bool)
          && (!('selesai_at' in data) || data.selesai_at is string);
    }

    // 3. Category Entity Validation
    function isValidCategory(data) {
      return data.keys().hasAll(['nama'])
          && data.keys().size() <= 6
          && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 50
          && (!('id_kategori' in data) || (data.id_kategori is string && data.id_kategori.size() <= 128))
          && (!('created_at' in data) || data.created_at is string)
          && (!('updated_at' in data) || data.updated_at is string);
    }

    // 4. Archived Report Entity Validation
    function isValidArchivedReport(data) {
      return data.keys().hasAll(['id_report', 'id_user', 'tipe_laporan', 'judul', 'deleted_at', 'deleted_by_name', 'deleted_by_role', 'delete_reason'])
          && data.keys().size() <= 24
          && data.id_report is string && data.id_report.size() <= 128
          && data.id_user is string && data.id_user.size() <= 128
          && data.tipe_laporan in ['HILANG', 'DITEMUKAN']
          && data.judul is string && data.judul.size() >= 1 && data.judul.size() <= 150
          && data.deleted_at is string
          && data.deleted_by_name is string && data.deleted_by_name.size() <= 100
          && data.deleted_by_role in ['petugas', 'warga', 'sistem']
          && data.delete_reason is string && data.delete_reason.size() <= 250
          && (!('id_archive' in data) || (data.id_archive is string && data.id_archive.size() <= 128))
          && (!('kategori' in data) || data.kategori is string)
          && (!('deskripsi' in data) || data.deskripsi is string)
          && (!('foto_url' in data) || data.foto_url is string)
          && (!('lokasi' in data) || data.lokasi is string)
          && (!('tgl_kejadian' in data) || data.tgl_kejadian is string)
          && (!('status_selesai' in data) || data.status_selesai is bool)
          && (!('selesai_at' in data) || data.selesai_at is string)
          && (!('created_at' in data) || data.created_at is string)
          && (!('user_nama' in data) || data.user_nama is string)
          && (!('user_whatsapp' in data) || data.user_whatsapp is string)
          && (!('status_disetujui' in data) || data.status_disetujui is bool)
          && (!('deleted_by_uid' in data) || data.deleted_by_uid is string);
    }

    // Match users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
                    && request.auth.uid == userId
                    && isValidUser(incoming())
                    && (!('is_admin' in incoming()) || incoming().is_admin == false || isAdmin());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && 
         isValidUser(incoming()) && 
         (!('is_admin' in incoming()) || 
          !('is_admin' in existing()) || 
          (incoming().is_admin == existing().is_admin))) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Match reports
    match /reports/{reportId} {
      allow get: if true;
      allow list: if true;
      
      allow create: if isSignedIn() 
                    && isValidId(reportId)
                    && incoming().id_user == request.auth.uid
                    && isValidReport(incoming())
                    && incoming().status_selesai == false
                    && (!('status_disetujui' in incoming()) || incoming().status_disetujui == false || isAdmin());
                    
      allow update: if isSignedIn() && (
        // Action: Resolve/Finish (ONLY the Owner who created the report can mark it as resolved)
        (existing().id_user == request.auth.uid 
         && isValidReport(incoming())
         && incoming().id_user == existing().id_user
         && incoming().tipe_laporan == existing().tipe_laporan
         && incoming().kategori == existing().kategori
         && incoming().judul == existing().judul
         && incoming().deskripsi == existing().deskripsi
         && incoming().foto_url == existing().foto_url
         && incoming().lokasi == existing().lokasi
         && incoming().tgl_kejadian == existing().tgl_kejadian
         && incoming().created_at == existing().created_at
         && incoming().user_nama == existing().user_nama
         && incoming().user_whatsapp == existing().user_whatsapp
         && ((!('status_disetujui' in incoming()) && !('status_disetujui' in existing())) || 
             (incoming().status_disetujui == existing().status_disetujui))
         && incoming().diff(existing()).affectedKeys().hasOnly(['status_selesai', 'selesai_at']))
        || 
        // Action: Admin updates (e.g. approval status_disetujui, or batch category update)
        // Petugas CANNOT change status_selesai on reports submitted by other users!
        (isAdmin() && (
          existing().id_user == request.auth.uid ||
          incoming().status_selesai == existing().status_selesai
        ))
      );
      
      allow delete: if isSignedIn() && (
        existing().id_user == request.auth.uid 
        || isAdmin() 
        || existing().status_selesai == true
      );
    }

    // Match categories (Managed by Petugas / Admin)
    match /categories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() && isValidCategory(incoming());
      allow update: if isAdmin() && isValidCategory(incoming());
      allow delete: if isAdmin();
    }

    // Match archived_reports (Only accessible by Petugas / Admin for history & audit)
    match /archived_reports/{archiveId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidArchivedReport(incoming());
      allow update: if isAdmin() && isValidArchivedReport(incoming());
      allow delete: if isAdmin();
    }
  }
}
