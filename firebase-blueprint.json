{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing name and WhatsApp contact info",
      "type": "object",
      "properties": {
        "id_user": { "type": "string", "maxLength": 128 },
        "nama_lengkap": { "type": "string", "maxLength": 100 },
        "no_whatsapp": { "type": "string", "maxLength": 20 },
        "created_at": { "type": "string" },
        "is_admin": { "type": "boolean" }
      },
      "required": ["id_user", "nama_lengkap", "no_whatsapp", "created_at"]
    },
    "Report": {
      "title": "Report",
      "description": "Lost or found item report posted by a resident",
      "type": "object",
      "properties": {
        "id_report": { "type": "string", "maxLength": 128 },
        "id_user": { "type": "string", "maxLength": 128 },
        "tipe_laporan": { "type": "string", "enum": ["HILANG", "DITEMUKAN"] },
        "kategori": { "type": "string", "maxLength": 50 },
        "judul": { "type": "string", "maxLength": 150 },
        "deskripsi": { "type": "string", "maxLength": 1000 },
        "foto_url": { "type": "string", "maxLength": 1000000 },
        "lokasi": { "type": "string", "maxLength": 200 },
        "tgl_kejadian": { "type": "string" },
        "status_selesai": { "type": "boolean" },
        "selesai_at": { "type": "string" },
        "created_at": { "type": "string" },
        "user_nama": { "type": "string", "maxLength": 100 },
        "user_whatsapp": { "type": "string", "maxLength": 20 }
      },
      "required": ["id_report", "id_user", "tipe_laporan", "kategori", "judul", "deskripsi", "lokasi", "tgl_kejadian", "status_selesai", "created_at", "user_nama", "user_whatsapp"]
    },
    "Category": {
      "title": "Category",
      "description": "Item category for lost and found reports managed by petugas",
      "type": "object",
      "properties": {
        "id_kategori": { "type": "string", "maxLength": 128 },
        "nama": { "type": "string", "maxLength": 50 },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id_kategori", "nama"]
    },
    "ArchivedReport": {
      "title": "ArchivedReport",
      "description": "Archived history of deleted and purged reports for officer audit",
      "type": "object",
      "properties": {
        "id_archive": { "type": "string", "maxLength": 128 },
        "id_report": { "type": "string", "maxLength": 128 },
        "id_user": { "type": "string", "maxLength": 128 },
        "tipe_laporan": { "type": "string", "enum": ["HILANG", "DITEMUKAN"] },
        "kategori": { "type": "string", "maxLength": 50 },
        "judul": { "type": "string", "maxLength": 150 },
        "deskripsi": { "type": "string", "maxLength": 2000 },
        "foto_url": { "type": "string", "maxLength": 1000000 },
        "lokasi": { "type": "string", "maxLength": 200 },
        "tgl_kejadian": { "type": "string" },
        "status_selesai": { "type": "boolean" },
        "selesai_at": { "type": "string" },
        "created_at": { "type": "string" },
        "user_nama": { "type": "string", "maxLength": 100 },
        "user_whatsapp": { "type": "string", "maxLength": 30 },
        "deleted_at": { "type": "string" },
        "deleted_by_uid": { "type": "string", "maxLength": 128 },
        "deleted_by_name": { "type": "string", "maxLength": 100 },
        "deleted_by_role": { "type": "string", "enum": ["petugas", "warga", "sistem"] },
        "delete_reason": { "type": "string", "maxLength": 250 }
      },
      "required": ["id_report", "id_user", "tipe_laporan", "judul", "deleted_at", "deleted_by_name", "deleted_by_role", "delete_reason"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles keyed by their Firebase Auth UID"
    },
    "reports/{reportId}": {
      "schema": "Report",
      "description": "Collection of lost & found reports"
    },
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of lost & found categories managed by petugas"
    },
    "archived_reports/{archiveId}": {
      "schema": "ArchivedReport",
      "description": "Audit archive of deleted reports accessible exclusively by petugas"
    }
  }
}
